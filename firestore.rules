rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: strict rules
    match /users/{userId} {
      allow read: if request.auth != null;

      // Create a user document only if the authenticated UID matches the doc id
      // and initial coin fields are zero (clients cannot grant themselves coins).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource.data.total_coins is int || request.resource.data.total_coins == null)
                    && (request.resource.data.winning_balance is int || request.resource.data.winning_balance == null)
                    && (request.resource.data.total_coins == 0 || request.resource.data.total_coins == null)
                    && (request.resource.data.winning_balance == 0 || request.resource.data.winning_balance == null);

      // Updates are allowed only when total_coins and winning_balance are NOT changed from server-side values.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.total_coins == resource.data.total_coins
                    && request.resource.data.winning_balance == resource.data.winning_balance;

      // No client-side deletes
      allow delete: if false;
    }

    // Transactions collection: clients can create a transaction request which MUST be processed
    // by a backend Cloud Function using Admin SDK to apply coin changes to user documents.
    match /transactions/{txId} {
      allow create: if request.auth != null
                    && request.resource.data.uid is string
                    && request.resource.data.type in ['credit','debit']
                    && request.resource.data.amount is int
                    && request.resource.data.amount > 0;
      allow read, update, delete: if false; // clients cannot read or modify other transactions
    }

    // Global configuration accessed by the app and managed by admin only.
    match /global_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'sahidafridiyt@gmail.com';
    }

    // Dispute documents: users can create reports; only admin can resolve.
    match /disputes/{disputeId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedBy is string
                    && request.resource.data.reporterEmail is string
                    && request.resource.data.cheaterId is string
                    && request.resource.data.status == 'pending';
      allow read: if request.auth != null
                  && (
                    resource.data.reportedBy == request.auth.uid
                    || request.auth.token.email == 'sahidafridiyt@gmail.com'
                  );
      allow update, delete: if request.auth != null
                            && request.auth.token.email == 'sahidafridiyt@gmail.com';
    }

    // Offerwall logs: users can write their own log; reads are allowed for authenticated app clients.
    match /offerwall_logs/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Admin notifications queue: only admin writes notifications.
    match /notifications/{notificationId} {
      allow create: if request.auth != null
                    && request.auth.token.email == 'sahidafridiyt@gmail.com';
      allow read: if false;
      allow update, delete: if false;
    }

    // Fallback: deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
